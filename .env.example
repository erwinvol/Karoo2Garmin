# Hammerhead Karoo Account Credentials
# (Or set KAROO_AUTH_TOKEN directly if your account requires SRAM SSO)
KAROO_EMAIL=your_karoo_email@example.com
KAROO_PASSWORD=your_karoo_password
# KAROO_AUTH_TOKEN=

# Garmin Connect Credentials
# Required on initial startup to generate tokens; thereafter tokens are cached in data/garmin_tokens
GARMIN_USERNAME=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Sync Behavior
SYNC_INTERVAL_MINUTES=60
SYNC_BATCH_SIZE=10
CHECK_DUPLICATES=true
DUPLICATE_THRESHOLD_HOURS=2

# Garmin Device Spoofing (Garmin Edge 1040: 3843, Edge 840: 4062)
SPOOF_GARMIN_DEVICE=true
DEVICE_PRODUCT_ID=3843
DEVICE_SOFTWARE_VERSION=27.10
ATHLETE_FTP=0

# Storage & Logging
DATA_DIR=./data
GARMIN_TOKEN_DIR=./data/garmin_tokens
LOG_LEVEL=INFO
